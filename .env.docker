# Aseta domain ja cas-tunnukset .env.docker.local-tiedostossa eri arvoon, jos haluat ajaa ympäristöä vasten
VIRKAILIJA_DOMAIN=virkailija.hahtuvaopintopolku.fi
CAS_USERNAME=DUMMY
CAS_PASSWORD=DUMMY
# CAS-urlit proxytetaan näillä oletusarvoilla paikallisen ympäristön kautta, jolloin kirjautuminen ohjataan yllä määriteltyyn VIRKAILIJA_DOMAIN-ympäristöön.
CAS_LOGIN_URL=http://localhost/cas/login
CAS_SERVICE_URL=http://localhost/suorituspalvelu
