    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@opetushallitus/oph-design-system": "^2.0.0",
    "@react-router/dev": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tanstack/react-query": "^5.107.1",
    "@tolgee/format-icu": "^7.3.0",
    "@tolgee/react": "^7.3.0",
    "date-fns": "^4.4.0",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-router": "^8.5.1",
    "remeda": "^2.58.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "start-server-and-test": "^3.0.13",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
