{
  "name": "suorituspalvelu-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "pnpm dlx only-allow@1.2.2 pnpm",
    "prepare": "cd .. && husky",
    "dev": "react-router dev --port 3000 --host",
    "build": "react-router build",
    "dev:test": "VITE_TEST=true pnpm run dev",
    "build:test": "VITE_TEST=true pnpm run build",
    "start": "pnpm exec tsx test-server.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prettier": "prettier -u -c *",
    "prettier:fix": "prettier --write -u *",
    "test": "vitest",
    "typecheck": "react-router typegen && tsc",
    "test-playwright-docker": "./scripts/run-playwright-tests-in-docker.sh",
    "start-and-test-playwright-docker": "START_SERVER_AND_TEST_INSECURE=1 start-server-and-test start http://localhost:3000 './scripts/run-playwright-tests-in-docker.sh $PLAYWRIGHT_ARGS'",
    "build-and-copy": "pnpm run build && ./scripts/copy-ui-bundle-to-backend.sh"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@emotion/react": "^11.14.0",
